# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Models (SRD v2.0 §4 & §9)
# Meta Model API (Muse Spark, Muse Wonder, Muse Image, SAM 3.1)
META_MODEL_API_KEY=
META_MODEL_API_BASE_URL=
# Muse Spark Open on Baseten / Modal (text fallback & trend scoring).
# Left empty, it uses the Meta Model API URL and key above, so the fallback
# shares Meta's outages and quota. Set both for an independent fallback (NFR-18).
MUSE_SPARK_OPEN_API_KEY=
MUSE_SPARK_OPEN_BASE_URL=
LLAMA_API_KEY=
LLAMA_API_BASE_URL=
# Optional: set to "mock" to force deterministic offline responses
GATEWAY_MODE=

# Jobs
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TOKEN_ENCRYPTION_KEY=

# Notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
RESEND_API_KEY=
